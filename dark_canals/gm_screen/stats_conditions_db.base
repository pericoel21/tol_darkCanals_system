filters:
  and:
    - file.path.startsWith("dark_canals")
formulas:
  Beauty Name: aliases[0]
  Associated Stat: connections[0]
properties:
  formula.Beauty Name:
    displayName: Name
  formula.Associated Stat:
    displayName: Associated Attribute
views:
  - type: cards
    name: Skills per Attribute
    filters:
      and:
        - file.tags.contains("skill")
    groupBy:
      property: formula.Associated Stat
      direction: ASC
    order:
      - formula.Beauty Name
      - description
    sort:
      - property: formula.Beauty Name
        direction: ASC
    columnSize:
      file.name: 122
      note.aliases: 196
      note.description: 412
    cardSize: 350
  - type: table
    name: PC Stats (All)
    filters:
      and:
        - file.tags.contains("stat")
    order:
      - file.name
      - formula.Beauty Name
      - description
      - tags
      - aliases
    columnSize:
      file.name: 32
      note.description: 524
      note.tags: 311
      note.aliases: 196
  - type: cards
    name: Conditions
    filters:
      and:
        - file.tags.contains("stat")
        - file.tags.contains("condition")
    order:
      - formula.Beauty Name
      - formula.Associated Stat
      - description
    sort:
      - property: formula.Associated Stat
        direction: ASC
      - property: formula.Beauty Name
        direction: ASC
    cardSize: 340
