filters:
  and:
    - file.path.contains("items/weapons")
    - '!file.name.contains("_base")'
formulas:
  Name: aliases[0]
views:
  - type: table
    name: All Weapons
    groupBy:
      property: weapon-type
      direction: ASC
    order:
      - file.name
      - formula.Name
      - weapon-type
      - size
      - traits
      - injury
      - description
      - aliases
    sort:
      - property: formula.Name
        direction: ASC
    columnSize:
      file.name: 50
      formula.Name: 155
      note.description: 515
