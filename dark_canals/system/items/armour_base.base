filters:
  and:
    - file.path.contains("items/armour")
    - '!file.name.contains("_base")'
formulas:
  Name: |-
    aliases[0
    ]
views:
  - type: cards
    name: All Armour
    groupBy:
      property: kit
      direction: ASC
    order:
      - formula.Name
      - size
      - location
      - injury
      - traits
    sort:
      - property: location
        direction: ASC
    columnSize:
      file.name: 48
      note.description: 718
    cardSize: 380
